{
  "name": "blogging-platfrom-v2-fullstack-turborepo",
  "version": "1.0.0",
  "description": "A full-stack blogging platform built using a Turborepo monorepo architecture.",
  "author": "Saveen Nidukshan",
  "license": "MIT",
  "keywords": [
    "blogging-platform",
    "fullstack",
    "turborepo",
    "monorepo",
    "typescript",
    "nodejs",
    "nextjs",
    "react",
    "web-development"
  ],
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "turbo": "^2.10.12",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "11.19.0"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
